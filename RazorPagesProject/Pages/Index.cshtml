@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-4">
            <h2>@(Model.EditId.HasValue ? "Edit" : "Add") Class Information</h2>
            <form method="post">
                <input type="hidden" asp-for="EditId" />
                <div class="form-group mb-3">
                    <label asp-for="ClassInfo.ClassName"></label>
                    <input asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ClassInfo.StudentCount"></label>
                    <input asp-for="ClassInfo.StudentCount" class="form-control" type="number" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ClassInfo.Description"></label>
                    <textarea asp-for="ClassInfo.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary" asp-page-handler="Add">@(Model.EditId.HasValue ? "Update" : "Add") Class</button>
                @if (Model.EditId.HasValue)
                {
                    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                }
            </form>
        </div>

        <!-- Table Column -->
        <div class="col-md-8">
            <h2>Class List</h2>
            
            <!-- Search Form -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" class="form-control" asp-for="SearchString" placeholder="Search by class name or description" />
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClasses)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-page="./Index" asp-route-editId="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                                <form method="post" style="display: inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-searchString="@Model.SearchString">Previous</a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-currentPage="@i" asp-route-searchString="@Model.SearchString">@i</a>
                            </li>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-searchString="@Model.SearchString">Next</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
