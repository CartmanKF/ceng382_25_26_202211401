@page "{pageNumber:int?}"
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<style>
    body {
        color: #333;
    }
    .table {
        color: #212529;
    }
    .modal-content {
        color: #212529;
    }
    .form-label {
        color: #212529;
    }
    .card-title {
        color: #212529;
    }
    input.form-control, 
    select.form-control, 
    textarea.form-control {
        color: #212529 !important;
    }
    input.form-control::placeholder, 
    select.form-control::placeholder, 
    textarea.form-control::placeholder {
        color: #6c757d !important;
    }
    .form-control:focus {
        color: #212529;
    }
    .modal input.form-control,
    .modal select.form-control,
    .modal textarea.form-control {
        background-color: #fff;
        color: #212529 !important;
    }
</style>

<a href="/Logout" class="btn btn-danger float-end" style="margin-top: 20px; margin-right: 20px;">Logout</a>

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="display-4 text-dark">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Export/Import Section -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">Export Options</h5>
                    <form method="post" asp-page-handler="ExportToJson">
                        <div class="form-group">
                            <label for="exportFiltered">Export Type</label>
                            <select name="exportFiltered" class="form-control" id="exportFiltered">
                                <option value="false">Export Current Page</option>
                                <option value="true">Export Filtered Data</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success mt-3">
                            <i class="fas fa-file-export"></i> Export to JSON
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Error/Success Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Add Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title text-primary mb-3">Add New Class</h5>
            <form id="addForm">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="className">Class Name</label>
                        <input type="text" class="form-control" id="className" required>
                    </div>
                    <div class="form-group col-md-2">
                        <label for="studentCount">Student Count</label>
                        <input type="number" class="form-control" id="studentCount" min="1" max="100" required>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="description">Description</label>
                        <input type="text" class="form-control" id="description" required>
                    </div>
                    <div class="form-group col-md-2">
                        <label>&nbsp;</label>
                        <button type="button" class="btn btn-primary btn-block" id="addClassBtn">
                            <i class="fas fa-plus"></i> Add Class
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>ID</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in Model.Classes)
                        {
                            <tr>
                                <td>@classInfo.Id</td>
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                                <td>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-warning btn-sm" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#editModal" 
                                                data-id="@classInfo.Id">
                                            Edit
                                        </button>
                                        <form method="post" asp-page-handler="Delete" style="display: inline;">
                                            <input type="hidden" name="id" value="@classInfo.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" 
                                                    onclick="return confirm('Are you sure you want to delete this class?')">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="d-flex justify-content-center">
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Index" asp-route-pageNumber="1" asp-route-searchTerm="@Model.SearchTerm">
                        <i class="fas fa-angle-double-left"></i>
                    </a>
                </li>
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">
                        <i class="fas fa-angle-left"></i>
                    </a>
                </li>

                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-page="/Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.SearchTerm">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">
                        <i class="fas fa-angle-right"></i>
                    </a>
                </li>
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/Index" asp-route-pageNumber="@Model.TotalPages" asp-route-searchTerm="@Model.SearchTerm">
                        <i class="fas fa-angle-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Edit Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editClassId" />
                    <div class="mb-3">
                        <label for="editClassName" class="form-label">Class Name</label>
                        <input type="text" class="form-control" id="editClassName" required />
                    </div>
                    <div class="mb-3">
                        <label for="editStudentCount" class="form-label">Student Count</label>
                        <input type="number" class="form-control" id="editStudentCount" min="1" max="100" required />
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editDescription" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveChanges">Save changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Edit modal show handler
            $('#editModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                
                $.get(`?handler=GetClass&id=${id}`, {
                    "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').first().val()
                })
                .done(function(data) {
                    console.log("Received data:", data);
                    $('#editClassId').val(data.id);
                    $('#editClassName').val(data.className);
                    $('#editStudentCount').val(data.studentCount);
                    $('#editDescription').val(data.description);
                })
                .fail(function(xhr, status, error) {
                    console.error("Error loading data:", error);
                    alert('Error loading class information: ' + error);
                });
            });

            // Save changes button click handler
            $('#saveChanges').click(function() {
                var form = $('#editForm');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var formData = {
                    id: parseInt($('#editClassId').val()) || 0,
                    className: $('#editClassName').val().trim(),
                    studentCount: parseInt($('#editStudentCount').val()) || 0,
                    description: $('#editDescription').val().trim()
                };

                console.log("Sending data:", formData);

                $.ajax({
                    url: window.location.pathname,
                    type: 'POST',
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    data: JSON.stringify(formData),
                    success: function(response) {
                        console.log("Success response:", response);
                        if (response.success) {
                            $('#editModal').modal('hide');
                            window.location.reload();
                        } else {
                            alert(response.error || 'Error saving changes');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("Error response:", xhr.responseText);
                        try {
                            var response = JSON.parse(xhr.responseText);
                            if (response.errors && response.errors.length > 0) {
                                alert(response.errors.join('\n'));
                            } else if (response.error) {
                                alert(response.error);
                            } else {
                                alert('An error occurred while saving');
                            }
                        } catch (e) {
                            alert('An error occurred while saving: ' + xhr.responseText);
                        }
                    }
                });
            });

            // Add form submission
            $('#addClassBtn').click(function() {
                var form = $('#addForm');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var formData = {
                    id: 0,
                    className: $('#className').val().trim(),
                    studentCount: parseInt($('#studentCount').val()) || 0,
                    description: $('#description').val().trim()
                };

                console.log("Adding new class:", formData);

                $.ajax({
                    url: window.location.pathname,
                    type: 'POST',
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    data: JSON.stringify(formData),
                    success: function(response) {
                        console.log("Success response:", response);
                        if (response.success) {
                            window.location.reload();
                        } else {
                            alert(response.error || 'Error adding class');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("Error response:", xhr.responseText);
                        try {
                            var response = JSON.parse(xhr.responseText);
                            if (response.errors && response.errors.length > 0) {
                                alert(response.errors.join('\n'));
                            } else if (response.error) {
                                alert(response.error);
                            } else {
                                alert('An error occurred while adding the class');
                            }
                        } catch (e) {
                            alert('An error occurred: ' + xhr.responseText);
                        }
                    }
                });
            });
        });
    </script>
}
