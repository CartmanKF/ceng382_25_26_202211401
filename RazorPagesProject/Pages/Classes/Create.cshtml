@page
@model RazorPagesProject.Pages.Classes.CreateModel

<h2>Add New Class</h2>
<form method="post">
    <div class="form-group">
        <label asp-for="Class.Name"></label>
        <input asp-for="Class.Name" class="form-control" />
        <span asp-validation-for="Class.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Class.PersonCount"></label>
        <input asp-for="Class.PersonCount" class="form-control" type="number" />
        <span asp-validation-for="Class.PersonCount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Class.Description"></label>
        <input asp-for="Class.Description" class="form-control" />
        <span asp-validation-for="Class.Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Class.IsActive"></label>
        <input asp-for="Class.IsActive" class="form-check-input" type="checkbox" />
        <span asp-validation-for="Class.IsActive" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Add</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form> 