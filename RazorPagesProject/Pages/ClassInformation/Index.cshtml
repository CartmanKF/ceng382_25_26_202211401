@page
@model RazorPagesProject.Pages.ClassInformation.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Class Information</h2>
        <div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addClassModal">
                Add New Class
            </button>
            <a href="/Logout" class="btn btn-danger">Logout</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Class Name</th>
                    <th>Student Count</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ClassInformation)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.ClassName</td>
                        <td>@item.StudentCount</td>
                        <td>@item.Description</td>
                        <td>
                            <button type="button" class="btn btn-warning btn-sm edit-class" 
                                    data-id="@item.Id"
                                    data-bs-toggle="modal" data-bs-target="#editClassModal">
                                Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Class Modal -->
<div class="modal fade" id="addClassModal" tabindex="-1" aria-labelledby="addClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addClassModalLabel">Add New Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" id="addForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" asp-for="EditClass.Id" value="0" />
                    <div class="mb-3">
                        <label asp-for="EditClass.ClassName"></label>
                        <input asp-for="EditClass.ClassName" class="form-control" />
                        <span asp-validation-for="EditClass.ClassName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditClass.StudentCount"></label>
                        <input asp-for="EditClass.StudentCount" class="form-control" type="number" min="0" />
                        <span asp-validation-for="EditClass.StudentCount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditClass.Description"></label>
                        <textarea asp-for="EditClass.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="EditClass.Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Class Modal -->
<div class="modal fade" id="editClassModal" tabindex="-1" aria-labelledby="editClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editClassModalLabel">Edit Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" asp-for="EditClass.Id" id="editId" />
                    <div class="mb-3">
                        <label asp-for="EditClass.ClassName"></label>
                        <input asp-for="EditClass.ClassName" class="form-control" id="editClassName" />
                        <span asp-validation-for="EditClass.ClassName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditClass.StudentCount"></label>
                        <input asp-for="EditClass.StudentCount" class="form-control" type="number" id="editStudentCount" min="0" />
                        <span asp-validation-for="EditClass.StudentCount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditClass.Description"></label>
                        <textarea asp-for="EditClass.Description" class="form-control" id="editDescription" rows="3"></textarea>
                        <span asp-validation-for="EditClass.Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Initialize form validation
            $.validator.unobtrusive.parse("#editForm");
            $.validator.unobtrusive.parse("#addForm");

            // Handle edit button click
            $('.edit-class').click(function() {
                var id = $(this).data('id');
                
                // Get class data with anti-forgery token
                $.get(`?handler=Edit&id=${id}`, {
                    "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(data) {
                    $('#editId').val(data.id);
                    $('#editClassName').val(data.className);
                    $('#editStudentCount').val(data.studentCount);
                    $('#editDescription').val(data.description);
                })
                .fail(function(xhr, status, error) {
                    alert('Error loading class information: ' + error);
                });
            });

            // Handle edit form submission
            $('#editForm').submit(function(e) {
                e.preventDefault();
                
                if (!$(this).valid()) {
                    return false;
                }

                var formData = {
                    EditClass: {
                        Id: $('#editId').val(),
                        ClassName: $('#editClassName').val(),
                        StudentCount: parseInt($('#editStudentCount').val()),
                        Description: $('#editDescription').val()
                    }
                };

                $.ajax({
                    url: '',
                    type: 'POST',
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify(formData),
                    success: function(response) {
                        $('#editClassModal').modal('hide');
                        location.reload();
                    },
                    error: function(xhr, status, error) {
                        alert('An error occurred while updating the class: ' + error);
                    }
                });
            });
        });
    </script>
} 